#!/usr/bin/env bash
# Builds the binaries of a release: an archive for each platform, with the
# license and the README, and their checksums.
#
# Usage: script/build-release VERSION DIR
set -euo pipefail

version=$1
dist=$2
build=$(mktemp -d)
trap 'rm -rf "$build"' EXIT
mkdir -p "$dist"

for target in linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 windows/amd64 windows/arm64; do
  os=${target%/*}
  arch=${target#*/}
  name="proof_${version}_${os}_${arch}"
  exe=proof
  [ "$os" = windows ] && exe=proof.exe
  mkdir "$build/$name"
  CGO_ENABLED=0 GOOS=$os GOARCH=$arch go build -trimpath -ldflags "-s -w -X main.version=$version" \
    -o "$build/$name/$exe" ./cmd/proof
  cp LICENSE README.md "$build/$name/"
  if [ "$os" = windows ]; then
    (cd "$build" && zip -qr - "$name") > "$dist/$name.zip"
  else
    tar -C "$build" -czf "$dist/$name.tar.gz" "$name"
  fi
done

(cd "$dist" && shasum -a 256 proof_* > checksums.txt)
